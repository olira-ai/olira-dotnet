# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real API keys.
#
# Load order: ExampleEnv.Load() reads examples/.env, then process environment
# variables override (CI / shell exports win over the file).

# API key with the scope(s) needed for the script you're running.
# Create one in the Olira Console (API Keys) with the scopes listed in README.md.
OLIRA_API_KEY=olira_dev_REPLACE_ME

# Base URL for the Olira API. Omit this — the SDK defaults to production.
# Only set if Olira has given you a custom endpoint, or for local app-api:
# OLIRA_BASE_URL=https://app-api.prod.olira.ai/app-api
# OLIRA_BASE_URL=http://localhost:8080/app-api

# Used by 06_ReadPatientState and 07_PatientToken — set to any patient ID that already has data.
PATIENT_ID=

# Used by 08_CohortManagement — set to a summary type slug active in your org (e.g. symptom_snapshot).
# If omitted, the template assignment steps are skipped.
OLIRA_EXAMPLE_SUMMARY_TYPE=

# Used by 12_DocumentResourceIngestion — path to a real PDF/PNG/JPEG for OCR.
# If omitted, the example writes a tiny stub PDF (upload works; OCR may fail on the stub).
# DOCUMENT_PATH=/path/to/note.pdf

# Optional: select a project workspace for data examples (slug or id).
# Project-management itself is demonstrated in 10_ProjectManagement (needs an org-wide key).
# OLIRA_PROJECT=dev-sandbox
